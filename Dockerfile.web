# Use versioned UADE CLI base image for stable, tested releases
# Pin specific versions to enable controlled updates and prevent breaking changes
# See docs/DOCKER_VERSIONING.md for versioning strategy
#
## Initial release: 3.05-base.1 (UADE binary version 3.05, 2025-11-11)
# Registry: GitHub Container Registry (GHCR) - ghcr.io/rib1/uade-cli:3.05-base.1
ARG BASE_IMAGE=ghcr.io/rib1/uade-cli:3.05-base.1
FROM ${BASE_IMAGE} AS uade-base

# Runtime stage - Add web server
FROM debian:stable-slim

# Install runtime dependencies + Python + tools for cloud environments
RUN apt-get update && apt-get install -y --no-install-recommends \
    libao4=1.2.2+20180113-1.2 \
    curl=8.14.1-2+deb13u2 \
    ca-certificates=20250419 \
    rsync=3.4.1+ds1-5+deb13u1 \
    unzip=6.0-29 \
    lhasa=0.4.0-1+b2 \
    python3=3.13.5-1 \
    python3-pip=25.1.1+dfsg-1 \
    python3-venv=3.13.5-1 \
    flac=1.5.0+ds-2 \
    && rm -rf /var/lib/apt/lists/*

# Copy UADE binaries and libraries from base image
COPY --from=uade-base /usr/local/bin/uade123 /usr/local/bin/
COPY --from=uade-base /usr/local/share/uade /usr/local/share/uade
COPY --from=uade-base /usr/local/lib/ /usr/local/lib/

# Update library cache
RUN ldconfig

# Create Python virtual environment and install dependencies
# hadolint ignore=DL3059
RUN python3 -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Create app directory structure and non-root user
# hadolint ignore=DL3059
RUN mkdir -p /app /opt/uade-web /tmp/modules /tmp/converted /tmp/cache && \
    useradd -m -u 1000 -s /bin/bash uade && \
    chown -R uade:uade /app /opt/uade-web /opt/venv && \
    chmod -R 777 /tmp/modules /tmp/converted /tmp/cache


# Must copy requirements.txt first to leverage Docker caching
COPY /web/requirements.txt /app/

# Install Python dependencies
RUN pip install --no-cache-dir -r /app/requirements.txt

# Copy web application
COPY web/ /app/

# Build metadata - placed late to avoid busting cache for unchanged layers
# GIT_COMMIT changes every build; keeping it here means apt-get, pip install,
# and UADE binary layers stay cached.
ARG GIT_COMMIT=unknown
ARG IMAGE_CREATED=unknown
ENV GIT_COMMIT=${GIT_COMMIT}
LABEL org.opencontainers.image.source=https://github.com/rib1/uade-docker
LABEL org.opencontainers.image.created=${IMAGE_CREATED}
LABEL org.opencontainers.image.revision=${GIT_COMMIT}
RUN if [ "$IMAGE_CREATED" = "unknown" ]; then date -u +"%Y-%m-%dT%H:%M:%SZ" > /opt/uade-web/image-build-time; else printf "%s\n" "$IMAGE_CREATED" > /opt/uade-web/image-build-time; fi

WORKDIR /app

# Switch to non-root user
USER uade

# Set environment variables for cloud deployment
ENV FLASK_APP=server.py
ENV FLASK_ENV=production
ENV PYTHONUNBUFFERED=1
ENV PORT=5000

# Expose port (cloud platforms read this)
EXPOSE 5000

# Health check for container orchestration
HEALTHCHECK --interval=30s --timeout=3s --retries=3 \
  CMD curl -f http://localhost:5000/health || exit 1

# Use gunicorn for production (better than Flask dev server for cloud)
# Single worker to minimize memory usage for large file streaming
# Use 8 threads to handle a mix of CPU-bound (conversion) and I/O-bound (streaming)
# requests concurrently. Python's GIL is released during I/O, allowing other threads to run.
# Since most requests serve cached files (I/O-bound), this configuration enables greater concurrency for simultaneous streams.
CMD ["gunicorn", "--bind", "0.0.0.0:5000", "--workers", "1", "--threads", "8", "--timeout", "300", "--graceful-timeout", "300", "--keep-alive", "5", "--worker-class", "gthread", "--access-logfile", "-", "--error-logfile", "-", "server:app", "--worker-tmp-dir", "/tmp", "--no-control-socket", "--pid", "/tmp/gunicorn.pid"]
