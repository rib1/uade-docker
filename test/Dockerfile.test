FROM python:3.15-alpine

RUN apk add --no-cache curl=~8.23 jq=~1.8 bash=~5.3 zip=~3.0 lha=~1.14

# Create a non-root user and a shared-volume group matching the web container's
# uade group, so endpoint tests can safely exercise shared /tmp cleanup.
RUN addgroup -S tester && adduser -S tester -G tester && \
    addgroup -g 1000 shared-uade-tmp && \
    addgroup tester shared-uade-tmp

RUN mkdir -p /home/tester/app && chown -R tester:tester /home/tester/app

WORKDIR /home/tester/app

# Create a directory for test fixtures and set ownership
RUN mkdir -p /home/tester/app/fixtures/invalid && chown -R tester:tester /home/tester/app/fixtures

# Cache prepared inputs separately from application and test code.
COPY --chown=tester:tester test/prepare-endpoint-fixtures.sh .
COPY --chown=tester:tester test/fixtures ./fixture-seed

# Switch to the non-root user
# The user is present in this image's /etc/passwd, so name resolution is deterministic.
# hadolint ignore=DL3066
USER tester

RUN FIXTURES_DIR=fixture-seed sh ./prepare-endpoint-fixtures.sh

COPY --chown=tester:tester test/*.sh .
COPY --chown=tester:tester test/report_endpoint_coverage.py ./report_endpoint_coverage.py
COPY --chown=tester:tester web/server.py ./web/server.py
RUN chmod +x ./*.sh

CMD ["/bin/bash", "./test_endpoints.sh"]
