FROM alpine:latest

RUN apk add --no-cache curl=~8.21 jq=~1.8 bash=~5.3 python3=~3.14

# Create a non-root user and group
RUN addgroup -S tester && adduser -S tester -G tester

RUN mkdir -p /home/tester/app && chown -R tester:tester /home/tester/app

WORKDIR /home/tester/app

# Create a directory for test fixtures and set ownership
RUN mkdir -p /home/tester/app/fixtures/invalid && chown -R tester:tester /home/tester/app/fixtures

# Copy the scripts and give ownership to the non-root user
COPY --chown=tester:tester test/*.sh .
COPY --chown=tester:tester test/report_endpoint_coverage.py ./report_endpoint_coverage.py
COPY --chown=tester:tester web/server.py ./web/server.py

RUN chmod +x ./*.sh

# Switch to the non-root user
# The user is present in this image's /etc/passwd, so name resolution is deterministic.
# hadolint ignore=DL3066
USER tester

CMD ["/bin/bash", "./test_endpoints.sh"]
