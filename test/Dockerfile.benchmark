FROM alpine:latest

RUN apk add --no-cache curl=~8.17 bash=~5.3

# Install k6 from the shared tooling manifest so Dependabot tracks the
# benchmark runner the same way it tracks the other test/quality tool images.
COPY test/docker-compose.tooling.yml /tmp/benchmark/docker-compose.tooling.yml
RUN K6_TAG="$(sed -n 's|^    image: grafana/k6:||p' /tmp/benchmark/docker-compose.tooling.yml)" \
    && curl --retry 5 --retry-delay 2 --retry-all-errors -fsSL "https://github.com/grafana/k6/releases/download/v${K6_TAG}/k6-v${K6_TAG}-linux-amd64.tar.gz" -o /tmp/k6.tar.gz \
    && tar xzf /tmp/k6.tar.gz -C /tmp \
    && mv "/tmp/k6-v${K6_TAG}-linux-amd64/k6" /usr/bin/k6 \
    && chmod +x /usr/bin/k6 \
    && rm -rf /tmp/k6.tar.gz "/tmp/k6-v${K6_TAG}-linux-amd64"

RUN addgroup -S benchmarker && adduser -S benchmarker -G benchmarker

RUN mkdir -p /workspace /reports && chown -R benchmarker:benchmarker /workspace /reports

WORKDIR /workspace

COPY --chown=benchmarker:benchmarker test/*.sh ./
COPY --chown=benchmarker:benchmarker test/bench ./bench

RUN chmod +x ./*.sh

USER benchmarker

ENTRYPOINT ["sh", "./run-benchmarks.sh"]
