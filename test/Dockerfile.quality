# UADE Docker - Code Quality Validation Service
#
# This Dockerfile creates a service that validates code quality before building
# Use with: docker compose -f docker-compose.yml -f test/docker-compose.quality.yml up quality-check
#
# This allows developers to run: docker compose up quality-check
FROM node:25-alpine

# Install bash, Python, Docker CLI, and other utilities
RUN apk add --no-cache \
    bash \
    grep \
    findutils \
    coreutils \
    curl \
    shellcheck \
    python3 \
    py3-pip \
    docker-cli

# Copy quality dependency manifests for reproducible installs
COPY test/package.json /tmp/quality/package.json
COPY test/requirements-quality.txt /tmp/quality/requirements-quality.txt
COPY test/docker-compose.tooling.yml /tmp/quality/docker-compose.tooling.yml

# Install hadolint and actionlint from tooling manifest tags
RUN ACTIONLINT_TAG="$(sed -n 's|^    image: rhysd/actionlint:||p' /tmp/quality/docker-compose.tooling.yml)" \
    && HADOLINT_TAG="$(sed -n 's|^    image: hadolint/hadolint:||p' /tmp/quality/docker-compose.tooling.yml)" \
    && HADOLINT_VERSION="${HADOLINT_TAG#v}" \
    && curl --retry 5 --retry-delay 2 --retry-all-errors -fsSL "https://github.com/rhysd/actionlint/releases/download/v${ACTIONLINT_TAG}/actionlint_${ACTIONLINT_TAG}_linux_amd64.tar.gz" -o /tmp/actionlint.tar.gz \
    && tar xzf /tmp/actionlint.tar.gz -C /tmp \
    && mv /tmp/actionlint /usr/local/bin/actionlint \
    && chmod +x /usr/local/bin/actionlint \
    && rm -f /tmp/actionlint.tar.gz \
    && curl --retry 5 --retry-delay 2 --retry-all-errors -fsSL "https://github.com/hadolint/hadolint/releases/download/v${HADOLINT_VERSION}/hadolint-Linux-x86_64" -o /usr/local/bin/hadolint \
    && chmod +x /usr/local/bin/hadolint

# Install frontend quality tools globally from manifest pins
RUN npm install -g \
    "eslint@$(node -p 'require("/tmp/quality/package.json").devDependencies.eslint')" \
    "stylelint@$(node -p 'require("/tmp/quality/package.json").devDependencies.stylelint')" \
    "htmlhint@$(node -p 'require("/tmp/quality/package.json").devDependencies.htmlhint')"

# Install Black, Ruff, mypy, and yamllint via pip
# hadolint ignore=DL3042,DL3059
RUN pip3 install --no-cache-dir --break-system-packages -r /tmp/quality/requirements-quality.txt

# Copy check script from test folder (context is project root)
COPY test/check-code-quality.sh /usr/local/bin/check-code-quality.sh
RUN chmod +x /usr/local/bin/check-code-quality.sh

# Set PROJECT_ROOT to the workspace mount point
ENV PROJECT_ROOT=/workspace

# Run the quality check script
CMD ["/usr/local/bin/check-code-quality.sh"]
