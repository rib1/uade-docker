FROM python:3.12.13-slim-bookworm

ARG CODEQL_VERSION=2.25.2

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        bash=5.2.15-2+b10 \
        ca-certificates=20230311+deb12u1 \
        curl=7.88.1-10+deb12u14 \
        tar=1.34+dfsg-1.2+deb12u1 \
    && rm -rf /var/lib/apt/lists/*

RUN curl --retry 5 --retry-delay 2 --retry-all-errors -fsSL \
        "https://github.com/github/codeql-action/releases/download/codeql-bundle-v${CODEQL_VERSION}/codeql-bundle-linux64.tar.gz" \
        -o /tmp/codeql-bundle-linux64.tar.gz \
    && curl --retry 5 --retry-delay 2 --retry-all-errors -fsSL \
        "https://github.com/github/codeql-action/releases/download/codeql-bundle-v${CODEQL_VERSION}/codeql-bundle-linux64.tar.gz.checksum.txt" \
        -o /tmp/codeql-bundle-linux64.tar.gz.checksum.txt \
    && sed -n 's|  codeql-bundle-linux64.tar.gz$|  /tmp/codeql-bundle-linux64.tar.gz|p' /tmp/codeql-bundle-linux64.tar.gz.checksum.txt > /tmp/codeql-bundle-linux64.tar.gz.sha256 \
    && sha256sum -c /tmp/codeql-bundle-linux64.tar.gz.sha256 \
    && mkdir -p /usr/local/codeql-home \
    && tar xzf /tmp/codeql-bundle-linux64.tar.gz -C /usr/local/codeql-home \
    && ln -s /usr/local/codeql-home/codeql/codeql /usr/local/bin/codeql \
    && rm -f \
        /tmp/codeql-bundle-linux64.tar.gz \
        /tmp/codeql-bundle-linux64.tar.gz.checksum.txt \
        /tmp/codeql-bundle-linux64.tar.gz.sha256

ENV PROJECT_ROOT=/workspace

ENTRYPOINT ["sh", "/workspace/test/run-codeql-local.sh"]
